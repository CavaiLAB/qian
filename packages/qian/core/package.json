{
  "name": "@cavailab/qian-core",
  "version": "0.2.0",
  "description": "Base UI + shadcn 源码自有化的基础组件（52 个）。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CavaiLAB/qian.git",
    "directory": "packages/qian/core"
  },
  "homepage": "https://github.com/CavaiLAB/qian/tree/main/packages/qian/core#readme",
  "bugs": {
    "url": "https://github.com/CavaiLAB/qian/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./manifest.json": "./dist/qian-manifest.json",
    "./shell": "./src/shell.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./manifest.json": "./dist/qian-manifest.json",
      "./shell": {
        "types": "./dist/shell.d.ts",
        "default": "./dist/shell.js"
      }
    }
  },
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "publint": "publint --strict --pack pnpm",
    "test": "vitest run",
    "postbuild": "node scripts/export-manifests.mjs",
    "manifest:generate": "node scripts/export-manifests.mjs --generate",
    "manifest:check": "node scripts/export-manifests.mjs --check"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@cavailab/qian-tokens": "workspace:^",
    "clsx": "catalog:",
    "tailwind-merge": "catalog:",
    "lucide-react": "catalog:",
    "react-resizable-panels": "catalog:",
    "@cavailab/qian-contracts": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@rslib/core": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "axe-core": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ajv": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "tailwindcss": "catalog:"
  }
}
